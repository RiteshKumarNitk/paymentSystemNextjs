generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  pending
  pending_verification
  confirmed
  rejected
  cancelled
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  upiId       String   // Merchant VPA
  upiName     String   // Merchant Name
  razorpayKeyId     String?  // Razorpay Key ID per tenant
  razorpayWebhookSecret String? // Razorpay Webhook Secret per tenant
  tagline     String?  // Short bio/motto
  brandColor  String   @default("#4F46E5") // Indigo 600
  logoUrl     String?  // CDN link to logo
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  events        Event[]
  members       Member[]
  bookings      Booking[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([slug])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(TENANT_ADMIN)
  createdAt    DateTime  @default(now())

  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([email])
  @@index([tenantId])
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String
  date        DateTime
  venue       String
  price       Int
  capacity    Int       @default(0)
  category    String    @default("general")
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  bookings    Booking[]

  @@index([tenantId])
  @@index([date])
  @@index([isActive])
}

model Booking {
  id               String        @id @default(uuid())
  orderId          String        @unique
  razorpayOrderId  String?       @unique // Razorpay order ID for automated payment
  razorpayPaymentId String?              // Razorpay payment ID on success
  name             String
  phone            String
  email            String
  amount           Int
  utr              String?
  status           BookingStatus @default(pending)
  checkedInAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  eventId   String
  event     Event         @relation(fields: [eventId], references: [id])

  memberId  String?
  member    Member?       @relation(fields: [memberId], references: [id])

  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([eventId])
  @@index([memberId])
  @@index([status])
  @@index([createdAt])
  @@index([razorpayOrderId])
}

model Member {
  id           String    @id @default(uuid())
  name         String
  phone        String
  email        String
  passwordHash String
  createdAt    DateTime  @default(now())

  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  bookings     Booking[]
  notifications Notification[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([email])
  @@index([tenantId])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("info") // info, success, warning
  createdAt DateTime @default(now())

  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([memberId])
  @@index([tenantId])
  @@index([isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String   // e.g. "BOOKING_CONFIRMED", "BOOKING_CANCELLED", "TENANT_CREATED"
  entityType String   // e.g. "Booking", "Tenant"
  entityId   String   // ID of the affected entity
  actorId    String?  // User/Member/System that triggered the action
  actorType  String?  // "SUPER_ADMIN", "TENANT_ADMIN", "MEMBER", "SYSTEM"
  metadata   Json?    // Additional context (old status, new status, amount, etc.)
  createdAt  DateTime @default(now())

  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
